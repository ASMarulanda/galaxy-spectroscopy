        given-names: D. G.
    journal: The Astronomical Journal
    volume: 120
    start: 1579
    year: 2000
  - type: article
    title: "The Eighteenth Data Release of the Sloan Digital Sky Surveys"
    authors:
      - family-names: Almeida
        given-names: A.
    year: 2023
    notes: "Source of the real spectra (SDSS-I/II Legacy, run2d=26, served by DR18)."
